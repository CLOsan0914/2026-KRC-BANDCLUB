<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <title>軽音部タイムスケジュール</title>

  <style>
    /* ============================
       🌤️ 青空フェス背景
       ============================ */
    body {
      background: linear-gradient(to bottom, #74c9ff, #dff6ff);
      color: #003366;
      font-family: 'Hiragino Sans', sans-serif;
      overflow-x: hidden;
      margin: 0;
      padding: 0;
    }

    body::before {
      content: "";
      position: fixed;
      top: 0;
      left: 0;
      width: 200%;
      height: 100%;
      background: url('https://i.imgur.com/8KpZQ0R.png') repeat-x;
      opacity: 0.25;
      animation: clouds 60s linear infinite;
      pointer-events: none;
    }

    @keyframes clouds {
      from { transform: translateX(0); }
      to { transform: translateX(-50%); }
    }

    /* ============================
       🌞 タイトル
       ============================ */
    h1 {
      text-align: center;
      font-size: 3.5em;
      color: #007bff;
      text-shadow:
        0 0 10px #ffffff,
        0 0 20px #aee6ff,
        0 0 40px #ffffff;
      letter-spacing: 3px;
      font-family: 'Impact', sans-serif;
      margin-bottom: 60px;
      margin-top: 40px;
      animation: shine 3s infinite;
    }

    @keyframes shine {
      0% { text-shadow: 0 0 10px #fff; }
      50% { text-shadow: 0 0 25px #fffa9e; }
      100% { text-shadow: 0 0 10px #fff; }
    }

    /* ============================
       🎪 説明文
       ============================ */
    .intro {
      width: 90%;
      margin: 0 auto 40px;
      padding: 30px;
      font-size: 1.2em;
      line-height: 1.8;
      color: #003366;
      background: rgba(255,255,255,0.85);
      border-left: 6px solid #ffdd55;
      border-right: 6px solid #ff7b7b;
      border-radius: 12px;
      box-shadow: 0 0 12px rgba(0, 120, 200, 0.3);
      box-sizing: border-box;
    }

    /* ============================
       🎤 スケジュール枠
       ============================ */
    .schedule {
      display: flex;
      flex-direction: column;
      gap: 60px;
      padding: 0 12px;
    }

    .slot {
      width: 100%;
      padding: 35px 25px;
      background: rgba(255,255,255,0.9);
      border: 3px solid #7ecbff;
      border-radius: 18px;
      box-shadow: 0 6px 15px rgba(0, 120, 200, 0.25);
      opacity: 0;
      transform: translateY(30px);
      transition: opacity 0.6s ease, transform 0.6s ease;
      position: relative;
    }

    .slot.visible {
      opacity: 1;
      transform: translateY(0);
    }

    .slot::before {
      content: "";
      position: absolute;
      top: -12px;
      left: 50%;
      transform: translateX(-50%);
      width: 60%;
      height: 12px;
      background: linear-gradient(90deg, #ffdd55, #ff7b7b);
      border-radius: 6px;
    }

    .slot h2 {
      margin: 0 0 10px;
      font-size: 2em;
      color: #0055aa;
    }

    .band-name {
      font-size: 2.6em;
      font-weight: bold;
      color: #0055aa;
      text-shadow: 2px 2px 4px rgba(0,0,0,0.15);
      margin-bottom: 10px;
    }

    .slot li {
      font-size: 1.4em;
      color: #004466;
      margin-bottom: 6px;
    }

    /* ============================
       📱 スマホ専用：画像最適化＋間隔拡大
       ============================ */
    @media (max-width: 600px) {

      .schedule {
        gap: 90px; /* コンテンツ間隔を広げる */
      }

      .slot {
        padding: 45px 28px; /* 枠内の余白を広げる */
      }

      .slot img {
        width: 100%;
        height: auto;          /* 縦長写真をそのまま表示 */
        object-fit: contain;   /* 人物が切れない */
        background-color: rgba(255,255,255,0.9);
        border-radius: 12px;
        border: 3px solid #fff;
        margin-top: 20px;
        margin-bottom: 25px;   /* 画像と次の要素の間隔 */
        box-shadow: 0 4px 10px rgba(0,0,0,0.2);
      }

      .slot h2 {
        margin-bottom: 20px; /* 時間と曲名の間隔 */
      }

      .slot ul {
        margin-top: 15px;
      }
    }

    /* PC用画像（そのまま） */
    .slot img {
      max-width: 100%;
      height: auto;
      border-radius: 12px;
      border: 3px solid #fff;
      margin-top: 15px;
      box-shadow: 0 4px 10px rgba(0,0,0,0.2);
    }

    /* ============================
       🔆 TOPボタン
       ============================ */
    #backToTop {
      position: fixed;
      bottom: 30px;
      right: 30px;
      padding: 12px 20px;
      font-size: 1em;
      background-color: #ffdd55;
      color: #333;
      border: none;
      border-radius: 50px;
      box-shadow: 0 0 15px #ffe98a;
      cursor: pointer;
      display: none;
      z-index: 1000;
      transition: opacity 0.3s ease;
    }

    #backToTop:hover {
      background-color: #ffe98a;
      box-shadow: 0 0 20px #fff6a0;
    }

  </style>
</head>

<body>

  <h1>KRC軽音部タイムスケジュール</h1>

  <div class="intro">
